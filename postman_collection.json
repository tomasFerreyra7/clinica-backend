              "raw": "{\n  \"hora_entrada\": \"15:00\",\n  \"hora_salida\": \"16:00\",\n  \"fecha\": \"{{fecha_agenda}}\",\n  \"id_medico\": {{id_medico_otro}},\n  \"id_especialidad\": {{id_especialidad_medico}},\n  \"id_sede\": {{id_sede}}\n}"
            }
          }
        },
        {
          "name": "Medico listar agenda ajena (403 esperado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('403 listar ajena', function () { pm.expect(pm.response.code).to.eql(403); });",
                  "pm.test('Formato respuesta', function () {",
                  "  pm.expect(data).to.have.keys('codigo', 'estado', 'datos');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_medico}}" }],
            "url": {
              "raw": "{{base_url}}/agendas?id_medico={{id_medico_otro}}",
              "host": ["{{base_url}}"],
              "path": ["agendas"],
              "query": [{ "key": "id_medico", "value": "{{id_medico_otro}}" }]
            }
          }
        }
      ]
    }
  ]
}
